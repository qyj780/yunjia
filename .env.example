# 复制为 .env.local 后填写。只在服务端读取；不要使用 NEXT_PUBLIC_ 前缀。
# BASE_URL 填 Chat Completions API 的基础地址，不包含 /chat/completions。
# 请按所选服务商文档填写以下三项，修改后重启本地服务。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Supabase 项目 Connect 页面中的 URL 与 Publishable Key。
# 仅由服务端读取，不需要 service_role 或数据库密码。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 正式网站完整地址，如 https://your-project.vercel.app
# 本地测试可填 http://localhost:3000
SITE_URL=
